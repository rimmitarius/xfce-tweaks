<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>XFCE Tweaks</vendor>
  <action id="org.xfce.tweaks.victus.hardware-control">
    <description>Change HP Victus fan, power or keyboard lighting settings</description>
    <message>Authentication is required to change HP Victus hardware settings</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/xfce-tweaks-victus-helper</annotate>
  </action>
</policyconfig>
